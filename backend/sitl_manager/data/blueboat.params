# BlueBoat vehicle layer.
#
# Derived from bluerobotics/Blueos-Parameter-Repository
# params/ardupilot/ArduRover/4.7/Navigator/BlueBoat120.params by diffing it against
# params/ardupilot/ArduRover/4.6/sitl/MotorBoat.params, which isolates what makes a
# BlueBoat a BlueBoat instead of a generic ArduRover motorboat.
#
# Board-specific entries from that diff are deliberately absent because they break or
# mean nothing in SITL: AHRS_ORIENTATION (would rotate the simulated IMU), BARO_EXT_BUS,
# the BATT_* pins and scaling factors (SITL feeds its own analog pins), INS_POS1_*,
# RNGFND1_TYPE (a Ping sonar that never answers fails the prearm check),
# SERVO*_TRIM/_REVERSED (real ESC wiring, which would make the simulated hull spin),
# RELAY*_FUNCTION, RC_OPTIONS and WNDVN_TYPE.
#
# The rover SITL layer is applied on top of this file and wins where both define a
# parameter, except for the driving tune below — the speeds, gains and turn geometry are
# only coherent together, and this hull cruises at 1 m/s where the generic rover SITL
# vehicle the overlay describes does 5 m/s.

# Hull and thruster mixing: two thrusters, differential (skid) steering.
#
# The outputs are in the order SITL reads them, which is the reverse of the shipped
# BlueBoat's wiring. SIM_Rover takes output 1 as the left motor and output 3 as the right
# one and derives yaw from their difference, whereas the real hull puts the right thruster
# on output 1 and reverses output 3 to suit how that thruster is mounted. Keeping the
# vehicle's order without its SERVO3_REVERSED would invert the steering loop, leaving the
# boat turning away from every waypoint.
FRAME_CLASS      2     # Boat — makes the firmware report MAV_TYPE_SURFACE_BOAT
FRAME_TYPE       0     # Undefined, unused by the boat frame class
SERVO1_FUNCTION  73    # ThrottleLeft
SERVO3_FUNCTION  74    # ThrottleRight
PILOT_STEER_TYPE 3     # Direct throttle-left/throttle-right pilot input

MOT_SLEWRATE     200
MOT_SPD_SCA_BASE 0
MOT_STR_THR_MIX  0.6
MOT_THST_ASYM    1.6

# Steering and speed control, tuned for the hull's inertia.
ACRO_TURN_RATE   45
ATC_ACCEL_MAX    0.7
ATC_BAL_D        0
ATC_DECEL_MAX    1
ATC_SPEED_P      1
ATC_STR_ACC_MAX  30
ATC_STR_ANG_P    1.2
ATC_STR_RAT_FF   0.8
ATC_STR_RAT_I    0
ATC_STR_RAT_IMAX 0
ATC_STR_RAT_MAX  30
ATC_STR_RAT_P    1
ATC_TURN_MAX_G   0.1
TURN_RADIUS      0.1   # Pivots in place on differential thrust

# Navigation speeds and waypoint behaviour.
AVOID_ACCEL_MAX  1
CRUISE_SPEED     1
CRUISE_THROTTLE  16
LOIT_RADIUS      1
RTL_SPEED        1
SPEED_MAX        3
WP_PIVOT_ANGLE   45
WP_PIVOT_RATE    15
WP_RADIUS        1
WP_SPEED         1

# A surface vehicle takes altitude from GNSS rather than the barometer.
EK3_GPS_CHECK    3
EK3_SRC1_POSZ    3
EK3_SRC2_POSZ    0
EK3_SRC3_POSZ    0

# Failsafes and arming, matching the shipped BlueBoat behaviour.
ARMING_RUDDER    0
FENCE_ACTION     5
FS_ACTION        6
FS_EKF_ACTION    0
FS_GCS_ENABLE    2
FS_THR_ENABLE    0
FS_TIMEOUT       5

GCS_PID_MASK     1
TEMP_LOG         1
